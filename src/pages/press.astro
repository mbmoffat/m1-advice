---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';

const slug = '/press';
const WWW = 'https://www.mortgageonefinance.co.uk';

// Live charts and data series on the main site that journalists can cite.
// Every link points at a page that is live on www.mortgageonefinance.co.uk.
const CHARTS = [
  {
    title: 'Bank Rate projection',
    href: `${WWW}/interest-rate-projection`,
    line: 'Where the market prices Bank Rate over the next ten years, updated as market pricing moves.',
  },
  {
    title: 'UK mortgage rates chart',
    href: `${WWW}/uk-mortgage-rates-chart`,
    line: 'Average two and five year fixed mortgage rates over time.',
  },
  {
    title: 'SONIA swap rates',
    href: `${WWW}/sonia-swap-rates`,
    line: 'Daily two and five year sterling swap rates, the wholesale rates lenders price fixed mortgages from.',
  },
  {
    title: 'Average UK mortgage payment',
    href: `${WWW}/average-mortgage-payment-uk`,
    line: 'The monthly payment a new buyer faces on the average-priced UK home, updated each month.',
  },
  {
    title: 'Average UK house price',
    href: `${WWW}/average-house-price-uk`,
    line: 'The average UK house price, monthly, from the UK House Price Index.',
  },
  {
    title: 'Bank of England base rate history',
    href: `${WWW}/bank-of-england-base-rate-history`,
    line: 'Bank Rate decisions over time, with the date of each move.',
  },
  {
    title: 'Swap rates and lender margin',
    href: `${WWW}/swap-rates-and-lender-margin`,
    line: 'How the gap between swap rates and fixed mortgage rates has moved since 2009, and why.',
  },
  {
    title: 'First-time buyer deposits',
    href: `${WWW}/mortgage-deposit-how-much`,
    line: 'The average first-time buyer deposit over time, and the average age of a first-time buyer.',
  },
];

// Rate Note issues, newest first. Add each issue here once it has been sent:
// { date: 'Thursday 10 December 2026', headline: '...' }
const RATE_NOTES: { date: string; headline: string }[] = [];

const TOPICS = [
  'Bank of England decisions and where Bank Rate is heading',
  'Fixed rate pricing, swap rates and how quickly lenders reprice',
  'Remortgaging and product transfers when a fixed deal ends',
  'Expat and non-UK resident borrowers buying or refinancing in the UK',
  'Seafarer, cruise and superyacht crew mortgages',
  'Buy-to-let and limited company landlords',
];
---

<BaseLayout
  title="Press and Media | Mortgage One"
  description="Press and media centre for Mortgage One: comment from Matt Moffat on mortgage rates, the Rate Note, and live UK rate charts journalists can cite."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Press and media', href: slug },
  ]}
>
  <section class="section">
    <div class="container press">
      <p class="eyebrow">For journalists</p>
      <h1>Press and media</h1>

      <p class="lead">
        Yes, Mortgage One is available for comment on mortgage rates and the UK mortgage market.
        Matt Moffat, Managing Director, comments on rate decisions, fixed rate pricing, remortgaging and specialist
        lending, with dated figures behind every view.
      </p>

      <p class="press-contact">
        Call <a href="tel:+441202155992">01202 155992</a> or email
        <a href="mailto:enquiry@mortgageonefinance.co.uk">enquiry@mortgageonefinance.co.uk</a> and mark your message
        press.
      </p>

      <h2>About Matt Moffat</h2>
      <p>
        Matt Moffat is the Managing Director of Mortgage One and a qualified mortgage adviser, holding the Certificate in
        Mortgage Advice and Practice (CeMAP), the Certificate in Regulated Equity Release (CeRER) and Member of the
        London Institute of Banking and Finance (MLIBF).
      </p>
      <p>
        Before founding Mortgage One he spent 30 years in institutional capital markets, working in fixed income, credit,
        foreign exchange and derivatives across London, Tokyo, Singapore, Hong Kong and Sydney. That background sits
        behind his reading of swap rates, gilt yields and Bank Rate pricing, the markets that set what borrowers pay for
        a fixed rate.
      </p>
      <p>
        He set up Mortgage One on returning to the UK from Sydney, having found no one who handled expat mortgages
        well. The firm now advises expats, seafarers, landlords and home buyers across the UK and abroad.
      </p>

      <h2>What Matt comments on</h2>
      <ul class="press-topics">
        {TOPICS.map((t) => <li>{t}</li>)}
      </ul>

      <h2>The Rate Note</h2>
      <p>
        The Rate Note is a one-page market note sent to money desks on the Thursday before each Bank of England
        decision. It carries where the market prices Bank Rate, how many of the largest lenders have repriced in the
        last four weeks, average fixed rates, and one broker view that is free to quote with attribution.
      </p>
      <p>
        To receive it, email <a href="mailto:enquiry@mortgageonefinance.co.uk">enquiry@mortgageonefinance.co.uk</a>
        with Rate Note in the subject line.
      </p>
      {RATE_NOTES.length > 0 && (
        <ul class="press-notes">
          {RATE_NOTES.map((n) => (
            <li>
              <strong>{n.date}</strong>: {n.headline}
            </li>
          ))}
        </ul>
      )}

      <h2>Live charts and data</h2>
      <p>
        These charts are kept up to date on the main Mortgage One site. Each carries its own data date and names its
        sources. Figures and charts may be quoted or reproduced with attribution to Mortgage One and a link to the
        chart page. For the underlying data or a fuller comment, get in touch.
      </p>

      <div class="grid grid--2 press-cards">
        {CHARTS.map((c) => (
          <a class="card press-card" href={c.href}>
            <span class="press-card__title">{c.title}</span>
            <span class="press-card__line">{c.line}</span>
            <span class="press-card__go">Open chart</span>
          </a>
        ))}
      </div>

      <p>
        The full set is on the <a href={`${WWW}/rates-charts-and-data`}>rates, charts and data page</a>.
      </p>

      <h2>About Mortgage One</h2>
      <p>
        Mortgage One is a UK mortgage broker advising clients across the country and overseas, with a specialism in
        expat, seafarer, buy-to-let and specialist residential cases. Mortgage One is a trading style of Sandsea Capital
        Ltd, registered in England and Wales, company number 11374947.
      </p>

      <CtaBlock heading="Looking for mortgage advice rather than a comment?" src={slug} />

      <p class="risk-warning">
        Think carefully before securing your debts against your home. Your home may be repossessed if you do not keep up
        repayments on your mortgage.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .press {
    max-width: 760px;
  }
  .press-contact {
    font-weight: 700;
  }
  .press-topics,
  .press-notes {
    padding-left: 1.25rem;
    line-height: 1.6;
  }
  .press-cards {
    margin-block: 1.5rem;
  }
  .press-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .press-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .press-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .press-card__line {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .press-card__go {
    margin-top: auto;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent-strong);
  }
  .risk-warning {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
    margin-top: 2.5rem;
  }
</style>
